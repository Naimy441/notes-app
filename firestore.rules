rules_version = '2';

// Single-user app: only the owner's verified Google account can read or write anything.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'abdullah.naim.441@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
